{
  "name": "crm-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "local": "vite build && vite preview --host 127.0.0.1 --port 4173 --strictPort --open",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test:crm": "node --test tests/crm-templates.test.mjs tests/crm-sync.test.mjs tests/crm-storage.test.mjs tests/crm-board.test.mjs tests/crm-shared.test.mjs",
    "start": "node server/start.mjs",
    "test": "npm run test:crm && npm run test:sites"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsdav": "^2.5.0",
    "vite": "6.4.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
